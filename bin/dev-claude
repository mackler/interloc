#!/usr/bin/env bash
# bin/dev-claude -- Claude Code in the development container of this repository.
#
# Usage:
#   bin/dev-claude [run] [claude arguments]   start the container if needed, then start Claude Code
#   bin/dev-claude shell                      open a Bash shell in the container
#   bin/dev-claude build                      build the image from ../claude-code-image
#   bin/dev-claude down                       stop and remove the container (the volume is kept)
#
# Examples:
#   bin/dev-claude                  new session
#   bin/dev-claude --continue       most recent session
#   bin/dev-claude run --resume     session list
#
# The script uses compose.cc.yaml in the root of the clone that contains the script, and that
# file mounts the same clone at /workspace. Run it from the development clone, not from the
# installed directory that project containers mount at /opt/plan-review.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
compose=(docker compose -f "$root/compose.cc.yaml")

ensure_running() {
    # 'up -d' does nothing when the container is already running.
    "${compose[@]}" up -d
}

command=${1:-run}
case "$command" in
    run | shell | build | down) shift || true ;;
    *) command=run ;; # every other first argument belongs to claude
esac

case "$command" in
    run)
        ensure_running
        exec "${compose[@]}" exec cc claude "$@"
        ;;
    shell)
        ensure_running
        exec "${compose[@]}" exec cc bash
        ;;
    build)
        exec "${compose[@]}" build
        ;;
    down)
        exec "${compose[@]}" down
        ;;
esac
